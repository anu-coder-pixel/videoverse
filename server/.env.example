# =============================================================================
# VideoVerse Backend - Environment Configuration Template
# =============================================================================
# Duplicate this file as .env and fill in your actual values.
# IMPORTANT: Never commit your real .env file or credentials to Git.

# Server Port (Render and Railway set this automatically in production)
PORT=5000

# Environment Mode ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection URI
# Ensure Network Access in MongoDB Atlas allows 0.0.0.0/0 for cloud deployments
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority

# JWT Authentication Secret (Use a strong random string in production)
JWT_SECRET=your_strong_random_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Production Frontend URL (Allowed for CORS and Cookies)
# Example: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# Razorpay Payment Gateway (Test Mode)
# Get keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_secret
