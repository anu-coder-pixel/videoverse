# =============================================================================
# VideoVerse Frontend - Environment Configuration Template
# =============================================================================
# Duplicate this file as .env and fill in your actual values.
# IMPORTANT: In Vite, only variables prefixed with VITE_ are exposed to the browser.

# Optional: Production Backend API Base URL
# Leave empty in local development to use Vite's built-in dev proxy.
# In production on platforms other than Vercel (or without vercel.json rewrites),
# set this to your hosted backend URL, e.g.: https://your-backend.onrender.com
VITE_API_BASE_URL=

# Razorpay Public Key ID (Test Mode)
# Safe to expose to the client. Starts with "rzp_test_"
# Keep in sync with RAZORPAY_KEY_ID in server/.env
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
